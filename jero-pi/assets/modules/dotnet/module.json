{
	"schema": "jero.module-contract/v2",
	"token": "dotnet",
	"version": "0.1.0",
	"description": ".NET 工程领域模块：24 个领域技能入口（风格/命名/现代 C#/可空/异步/并发/API 设计/性能/基准/诊断/测试/MSBuild/EF Core/DI/配置/序列化/AOT/Aspire/Akka/Web API/NuGet/项目/升级/可观测）+ 26 篇深知识 references 与 1 篇出处账本，附评审/测试/架构三角色，知识锚定 .NET 10/C# 14。",
	"dependencies": [],
	"triggers": {
		"files": ["**/*.sln", "**/*.csproj", "**/*.cs", "global.json"],
		"intents": [".NET", "dotnet", "C#", "CSharp", "csharp", "ASP.NET", "EF Core", "Blazor", "NuGet", "xUnit", "异步"]
	},
	"knowledge": {
		"entry": "knowledge/SKILL.md",
		"references": ["references/*.md"]
	},
	"roles": [
		{
			"name": "dotnet-reviewer",
			"isolation": ["adversarial-eyes", "least-privilege"],
			"permission": "read-only",
			"model": "balanced",
			"output": "findings-report"
		},
		{
			"name": "dotnet-tester",
			"isolation": ["least-privilege"],
			"permission": "write-bounded",
			"model": "fast",
			"output": "verification-report"
		},
		{
			"name": "dotnet-architect",
			"isolation": ["least-privilege"],
			"permission": "read-only",
			"model": "deep-reasoning",
			"output": "design-proposal"
		}
	],
	"bindings": {
		"inline": { "inject": "entry" },
		"explore": { "inject": "manifest-only" },
		"worker": { "inject": "entry" },
		"verify": { "inject": "entry", "appendRoles": ["dotnet-tester"] },
		"sdd-planning": { "inject": "entry" },
		"sdd-execution": { "inject": "entry" },
		"review": { "inject": "entry", "appendRoles": ["dotnet-reviewer"] },
		"answer": { "inject": "entry" }
	},
	"routing": [
		{
			"when": { "surface": "review" },
			"action": "delegate-role",
			"target": "dotnet-reviewer"
		},
		{
			"when": { "surface": "verify" },
			"action": "delegate-role",
			"target": "dotnet-tester"
		},
		{
			"when": { "slip": { "utteranceType": "design-request", "crossModule": true } },
			"action": "suggest-role",
			"target": "dotnet-architect"
		}
	],
	"config": {
		"testCommand": "dotnet test",
		"gitignore": ["bin/", "obj/"]
	}
}
