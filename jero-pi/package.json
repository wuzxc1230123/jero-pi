{
	"name": "jero-pi",
	"version": "0.1.0",
	"description": "Pi coding-agent harness rebuilt on jero-pi: SDD/OpenSpec, subagents, strict TDD evidence, in-process review authority, persistent memory, zero native binaries.",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"jero-pi",
		"sdd",
		"openspec",
		"subagents",
		"tdd",
		"code-review",
		"ai-coding-agent",
		"agent-harness"
	],
	"files": [
		"assets/",
		"docs/",
		"extensions/",
		"lib/",
		"prompts/",
		"runtime/",
		"skills/",
		"scripts/",
		"tests/",
		"themes/",
		"README.md",
		"schemas/"
	],
	"scripts": {
		"postinstall": "node scripts/install-tui-mode-setting.mjs",
		"test": "node --experimental-strip-types --test \"tests/*.test.ts\" \"tests/authority/*.test.ts\" && pnpm run test:harness",
		"test:harness": "node --experimental-strip-types tests/runtime-harness.mjs",
		"build:runtime-modules": "node scripts/build-runtime-modules.mjs --write",
		"check:runtime-modules": "node scripts/build-runtime-modules.mjs --check",
		"typecheck": "node scripts/check-types.mjs",
		"prepack": "pnpm test && pnpm run check:runtime-modules && node scripts/verify-package-files.mjs",
		"prepublishOnly": "pnpm test && pnpm run check:runtime-modules && node scripts/verify-package-files.mjs"
	},
	"pi": {
		"image": "assets/jero-logo.png",
		"extensions": [
			"./extensions"
		],
		"themes": [
			"./themes"
		],
		"prompts": [
			"./prompts"
		],
		"skills": [
			"./skills"
		]
	},
	"dependencies": {
		"@earendil-works/pi-tui": "0.85.1",
		"@heyhuynhgiabuu/pi-pretty": "0.6.14"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.85.1",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@types/node": "^24.13.3",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@11.1.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jero-pi/jero-pi.git"
	}
}
