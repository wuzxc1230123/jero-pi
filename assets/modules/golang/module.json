{
	"schema": "jero.module-contract/v2",
	"token": "golang",
	"version": "0.1.0",
	"description": "Go 工程领域模块：21 个领域技能入口（风格/命名/声明/错误/防御/并发/context/接口/泛型/数据结构/测试/基准/性能/排障/安全/slog/项目布局/依赖/CLI/现代化/gopls MCP 接线）+ 27 篇深知识 references 与 1 篇出处账本，附评审/测试/架构三角色，知识锚定 Go 1.25/1.26。",
	"dependencies": [],
	"triggers": {
		"files": ["go.mod", "**/*.go"],
		"intents": ["Go", "Golang", "goroutine", "channel", "切片", "并发", "泛型", "接口", "go test", "gofmt", "golangci"]
	},
	"knowledge": {
		"entry": "knowledge/SKILL.md",
		"references": ["references/*.md"]
	},
	"roles": [
		{
			"name": "golang-reviewer",
			"isolation": ["adversarial-eyes", "least-privilege"],
			"permission": "read-only",
			"model": "balanced",
			"output": "findings-report"
		},
		{
			"name": "golang-tester",
			"isolation": ["least-privilege"],
			"permission": "write-bounded",
			"model": "fast",
			"output": "verification-report"
		},
		{
			"name": "golang-architect",
			"isolation": ["least-privilege"],
			"permission": "read-only",
			"model": "deep-reasoning",
			"output": "design-proposal"
		}
	],
	"bindings": {
		"inline": { "inject": "entry" },
		"explore": { "inject": "manifest-only" },
		"worker": { "inject": "entry" },
		"verify": { "inject": "entry", "appendRoles": ["golang-tester"] },
		"sdd-planning": { "inject": "entry" },
		"sdd-execution": { "inject": "entry" },
		"review": { "inject": "entry", "appendRoles": ["golang-reviewer"] },
		"answer": { "inject": "entry" }
	},
	"routing": [
		{
			"when": { "surface": "review" },
			"action": "delegate-role",
			"target": "golang-reviewer"
		},
		{
			"when": { "surface": "verify" },
			"action": "delegate-role",
			"target": "golang-tester"
		},
		{
			"when": { "slip": { "utteranceType": "design-request", "crossModule": true } },
			"action": "suggest-role",
			"target": "golang-architect"
		}
	],
	"config": {
		"testCommand": "go test ./..."
	}
}
